<?php namespace ProcessWire;

/**
 * ProcessWire InputfieldSimpleMDE
 *
 * A Markdown editor inputfield, built on EasyMDE.
 *
 * @author Macrura / outflux3
 * @license MIT (see LICENSE)
 * @see https://github.com/Ionaru/easy-markdown-editor
 *
 * NOTE ON THE NAME
 * The module is still called InputfieldSimpleMDE because renaming the class
 * would orphan every field already using it. The editor it ships is EasyMDE,
 * the maintained fork of the abandoned SimpleMDE. See README.md.
 *
 * @property string $mde_options Per-field EasyMDE options as a JSON fragment
 *
 */

class InputfieldSimpleMDE extends InputfieldTextarea {

	public static function getModuleInfo() {
		return array(
			'title' => 'Simple Markdown Editor',
			'version' => 200,
			'summary' => 'Markdown editor (EasyMDE) for ProcessWire',
			'icon' => 'star',
			'requires' => 'ProcessWire>=3.0.0, PHP>=5.4.0',
			'autoload' => 'template=admin',
			);
	}

	/**
	 * Per the Module interface, initialize the Inputfield and load its assets
	 *
	 */
	public function init() {
		parent::init();

		// Per-field EasyMDE options, as a JSON fragment. A setting rather than an
		// attribute, so it is never emitted onto the textarea by getAttributesString().
		$this->set('mde_options', '');

		$name = $this->className();
		$info = self::getModuleInfo();
		$version = (int) $info['version'];
		$url = $this->wire()->config->urls->$name;

		$this->wire()->config->styles->add($url . "easymde/easymde.min.css?v=$version");
		$this->wire()->config->scripts->add($url . "easymde/easymde.min.js?v=$version");

		/**
		 * REPEATER FIX. The vendor library was loaded here, but this module's
		 * OWN InputfieldSimpleMDE.js was not — ProcessWire adds a module's file
		 * assets from Inputfield::renderReady(), which only runs when the field
		 * actually renders.
		 *
		 * Inside a repeater that is fatal. With every item collapsed, no
		 * InputfieldSimpleMDE renders on page load, so the init script never
		 * reaches the page; opening an item then injects a textarea by AJAX
		 * with nothing present to turn it into an editor. It appeared to work
		 * only when some item happened to be open at load, which is why it
		 * looked intermittent.
		 *
		 * loadModuleFileAssets() is the same call renderReady() makes, so the
		 * URL is byte-identical and $config->scripts de-duplicates instead of
		 * loading the file twice. This module is autoload=template=admin, so
		 * this runs on every admin request whether a field renders or not.
		 *
		 * COST: the library loads on every admin request, not only on pages
		 * holding an MDE field. That is deliberate. Gating it on the current
		 * Process would drop it in exactly the cases that are hard to predict
		 * (custom Process modules, third parties such as FieldDescriptionsExtended
		 * that ask for the library themselves), and this module's job is to work
		 * everywhere without per-site tuning.
		 */
		$this->wire()->modules->loadModuleFileAssets($this);
	}

	public function ___render() {
		return parent::___render();
	}

	public function getAttributes() {
		$attrs = parent::getAttributes();

		// Marker class for the JS. Unconditional: the previous version only added
		// it when 'size' was empty, a guard inherited from InputfieldText that is
		// meaningless here — InputfieldTextarea::___render() unsets 'size' itself.
		// A stray size attribute would have silently disabled the whole editor.
		$attrs['class'] = (empty($attrs['class']) ? '' : $attrs['class'] . ' ')
			. 'InputfieldMaxWidth InputfieldSimpleMDEField';
		unset($attrs['size']);

		// Per-field options travel on the element itself rather than in
		// ProcessWire.config, so an AJAX-loaded repeater item and each textarea of
		// a multi-language field carry their own config with no lookup by name.
		$options = trim((string) $this->mde_options);
		if(strlen($options)) $attrs['data-mde-options'] = $options;

		return $attrs;
	}

	public function setAttribute($key, $value) {

		if($key == 'maxlength' && !(int) $value) $value = ''; // blank string prevents a maxlength='0' attribute

		if($key == 'value') {
			if($value) $value = trim($value);
			$maxlength = (int) $this->attr('maxlength');
			if($maxlength > 0) $value = substr($value, 0, $maxlength);
		}

		return parent::setAttribute($key, $value);
	}

	/**
	 * Field configuration
	 *
	 * Purely additive: an empty value renders exactly as the module did before this
	 * option existed. Whatever is entered here is merged OVER the JS defaults, so a
	 * field that sets only one key keeps the stock toolbar for everything else.
	 *
	 */
	public function ___getConfigInputfields() {
		$inputfields = parent::___getConfigInputfields();

		/** @var InputfieldTextarea $f */
		$f = $this->wire()->modules->get('InputfieldTextarea');
		$f->attr('name', 'mde_options');
		$f->label = $this->_('EasyMDE options');
		$f->description = sprintf(
			$this->_('Optional. Leave blank to use the default toolbar and settings. Options are merged over the defaults, so you only need the keys you want to change. Enter them in JSON format, with keys in double quotes. See the [EasyMDE documentation](%s).'),
			'https://github.com/Ionaru/easy-markdown-editor#configuration'
		);
		$f->notes = $this->_('Example:') . "\n```\n\"toolbar\": [\"bold\", \"italic\", \"heading\", \"|\", \"preview\"],\n\"sideBySideFullscreen\": false\n```";
		$f->attr('value', $this->mde_options);
		$f->collapsed = Inputfield::collapsedBlank;
		$inputfields->add($f);

		return $inputfields;
	}

	/**
	 * Allow the options to be set per template context
	 *
	 */
	public function ___getConfigAllowContext($field) {
		return array_merge(parent::___getConfigAllowContext($field), array('mde_options'));
	}

}
